# ============================================================
#  BTS PROJECT — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git — it's in .gitignore already.
# ============================================================

# --- Django Core ---
SECRET_KEY=your-very-long-random-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=yourdomain.onrender.com,localhost,127.0.0.1

# --- Database ---
# On Render, set this to your PostgreSQL Internal Database URL
# Locally, you can use SQLite by leaving this blank
DATABASE_URL=postgresql://user:password@host:5432/bts_db

# --- Static & Media Files ---
# On Render, static files are served by WhiteNoise (no S3 needed for MVP)
# For production media uploads, set up Cloudinary:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (for order confirmations, password reset) ---
# HOW TO SET UP GMAIL:
# 1. Go to myaccount.google.com → Security → 2-Step Verification (turn ON)
# 2. Then go to myaccount.google.com → Security → App Passwords
# 3. Create an App Password for "Mail" → copy the 16-digit code
# 4. Paste it as EMAIL_HOST_PASSWORD below (no spaces)
# 5. Put your Gmail address as EMAIL_HOST_USER
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=BTS Project <noreply@btsproject.ng>

# --- Paystack (Nigerian Payments) ---
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- App Settings ---
BTS_MIN_CUSTOM_ITEMS=5
BTS_CUSTOM_PACKAGING_FEE=1500
